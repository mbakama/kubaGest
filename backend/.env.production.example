# Copier sur le VPS : cp .env.production.example .env puis éditer les valeurs.

NODE_ENV=production
PORT=3000

# Domaine du front / mobile (CORS). Exemple : https://app.votredomaine.com
CORS_ORIGIN=https://app.votredomaine.com

SWAGGER_ENABLED=false

DB_TYPE=postgres
DB_SYNCHRONIZE=false
DB_LOGGING=false

POSTGRES_USER=kubagest
POSTGRES_PASSWORD=REMPLACER_MOT_DE_PASSE_FORT
POSTGRES_DB=kubagest

# Générer : openssl rand -hex 32
JWT_SECRET=REMPLACER_AU_MOINS_32_CARACTERES_ALEATOIRES
JWT_EXPIRES_IN=7d

# URL publique de l'API (emails, liens). Exemple : https://api.votredomaine.com
APP_PUBLIC_URL=https://api.votredomaine.com

# Super admin plateforme (optionnel, les deux ensemble)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# SMTP (optionnel, reset mot de passe)
# MAIL_DRIVER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=KubaGest
# MAIL_ENCRYPTION=ssl
