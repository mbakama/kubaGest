# Application
# NODE_ENV: development | test | production
NODE_ENV=development
# Port HTTP utilisé par l'API
PORT=3000
# Origines autorisées pour CORS, séparées par des virgules ("*" pour tout autoriser)
CORS_ORIGIN=*
# Documentation OpenAPI servie sur /docs
SWAGGER_ENABLED=true

# Base de données
# DB_TYPE: postgres (référence, migrations) | sqljs (local sans serveur)
DB_TYPE=sqljs
# Fichier SQLite (ignoré si vide : base en mémoire)
DB_LOCATION=.data/kubagest.sqlite
# Requis uniquement avec DB_TYPE=postgres
DATABASE_URL=postgresql://kubagest:kubagest_dev_pwd@localhost:5432/kubagest
# sqljs exige true ; postgres exige false en production (migrations)
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Répertoire privé où sont conservés les avatars téléversés
AVATAR_STORAGE_DIR=.data/avatars

# Utilisé par docker compose (les valeurs par défaut de docker-compose.yml restent valables)
POSTGRES_USER=kubagest
POSTGRES_PASSWORD=kubagest_dev_pwd
POSTGRES_DB=kubagest
POSTGRES_PORT=5432

# Authentification JWT
# Générer un secret robuste, par exemple : openssl rand -hex 32
JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=1h

# NestJS Observe (optionnel) - https://observe.nestjs.com
# Renseigner les deux clés ensemble pour activer la télémétrie.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=kubagest-backend

# Super administrateur plateforme (optionnel) : compte créé ou promu au démarrage.
# Gestion des tenants et abonnements uniquement, sans accès aux données métier.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# SMS Twilio (optionnel). Compte, jeton, et le service de messagerie (MG...)
# copié depuis la console. TWILIO_FROM_NUMBER peut remplacer ce service.
# L'essai n'envoie qu'aux numéros vérifiés, pendant 30 jours.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Courriel de réinitialisation (optionnel). Absent, ou complet.
# Le port 587 avec MAIL_ENCRYPTION=ssl utilise STARTTLS.
# APP_PUBLIC_URL sert à construire le lien placé dans le message.
MAIL_DRIVER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_ENCRYPTION=
APP_PUBLIC_URL=
